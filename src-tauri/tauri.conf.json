{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCHST Staff",
  "version": "1.0.1",
  "identifier": "ng.edu.ochst.staff",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Olivet College of Health Technology",
    "category": "Education",
    "shortDescription": "OCHST Staff portal",
    "longDescription": "The Olivet College of Health Technology staff portal in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
